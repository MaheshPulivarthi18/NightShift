# Copy to .env and fill in. Never commit .env.

# Every model call goes through OpenRouter, whatever the model's vendor.
OPENROUTER_API_KEY=

# Fine-grained GitHub token with read-only access to public repositories. Never a token that can write:
# publishing uses your own `gh` login instead.
GITHUB_TOKEN=
# Your GitHub login: your own PRs and assignments are not treated as someone else's claim.
NIGHTSHIFT_GITHUB_LOGIN=

NIGHTSHIFT_DATABASE_URL=postgresql+psycopg://nightshift:nightshift@localhost:5432/nightshift

# Spend caps in USD, checked before every model call.
NIGHTSHIFT_DAILY_BUDGET_USD=1.25
NIGHTSHIFT_MONTHLY_BUDGET_USD=40
# NIGHTSHIFT_TASK_BUDGET_USD=5
# NIGHTSHIFT_PR_CHECK_BUDGET_USD=1.5

# Models per agent: any OpenRouter model id. `nightshift models` shows the defaults and how each has done.
# NIGHTSHIFT_CODER__MODEL=anthropic/claude-sonnet-5.5
# NIGHTSHIFT_CODER__LADDER='["anthropic/claude-opus-5.5"]'
# NIGHTSHIFT_REVIEWER__MODEL=openai/gpt-5.6-sol

# Last line of commits NightShift publishes. Empty to leave it out.
# NIGHTSHIFT_COMMIT_ATTRIBUTION="Generated by NightShift"
