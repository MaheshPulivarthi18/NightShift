# Copy to .env and fill in. Never commit .env.

# Claude access: either the Claude API directly, or through OpenRouter.
NIGHTSHIFT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# NIGHTSHIFT_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Fine-grained GitHub token with read-only access to public repositories.
GITHUB_TOKEN=

NIGHTSHIFT_DATABASE_URL=postgresql+psycopg://nightshift:nightshift@localhost:5432/nightshift

# Spend caps in USD.
NIGHTSHIFT_DAILY_BUDGET_USD=1.25
NIGHTSHIFT_MONTHLY_BUDGET_USD=40
NIGHTSHIFT_PER_REPORT_BUDGET_USD=5

# Per-agent models. Defaults: claude-opus-5-5 for all three.
# NIGHTSHIFT_RELEVANCE__MODEL=claude-haiku-5-5
# NIGHTSHIFT_RELEVANCE__EFFORT=low
# NIGHTSHIFT_PR_ASSESSOR__EFFORT=medium
# NIGHTSHIFT_VERIFIER__EFFORT=medium
